# API
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/danceapp

JWT_ACCESS_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_REFRESH_EXPIRES_IN=30d

# OTP
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=DANCE
OTP_PROVIDER=mock

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# Push
FCM_SERVICE_ACCOUNT_JSON=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@danceapp.com

# Misc
LOG_LEVEL=info
REDIS_URL=
WEB_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
